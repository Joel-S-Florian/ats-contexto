generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  recruiter
  area_manager
}

enum TenantStatus {
  active
  suspended
}

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  status      TenantStatus @default(active)
  createdAt   DateTime     @default(now()) @map("created_at")
  memberships Membership[]
  invitations Invitation[]
  auditLogs   AuditLog[]

  @@map("tenants")
}

// Usuario global (el correo es unico en la plataforma). Pertenece a tenants via Membership.
model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  name         String
  passwordHash String          @map("password_hash")
  isSuperAdmin Boolean         @default(false) @map("is_super_admin")
  createdAt    DateTime        @default(now()) @map("created_at")
  memberships  Membership[]
  sessions     Session[]
  resets       PasswordReset[]

  @@map("users")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@map("memberships")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id])

  @@map("password_resets")
}

model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  email      String
  role       Role
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@map("invitations")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  target    String?
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

enum VacancyStatus {
  draft
  published
  paused
  closed
}

enum JobCategory {
  general
  technical
  operational
  administrative
  managerial
  junior
}

enum ExperienceLevel {
  internship
  junior
  semi_senior
  senior
  managerial
}

enum EmploymentType {
  full_time
  part_time
  contract
  temporary
  internship
}

enum WorkMode {
  onsite
  hybrid
  remote
}

enum SkillKind {
  required
  desirable
}

enum StageType {
  screening
  interview
  assessment
  selection
  hiring
  custom
}

model Pipeline {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  name      String
  isDefault Boolean         @default(false) @map("is_default")
  createdAt DateTime        @default(now()) @map("created_at")
  stages    PipelineStage[]
  vacancies Vacancy[]

  @@index([tenantId])
  @@map("pipelines")
}

model PipelineStage {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  pipelineId String    @map("pipeline_id") @db.Uuid
  name       String
  type       StageType
  position   Int
  enabled    Boolean   @default(true)
  // Configuracion propia de la etapa y regla de transicion (manual | umbral | resultado de examen).
  config     Json      @default("{}")
  transition Json      @default("{\"mode\":\"manual\"}")
  pipeline   Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, position])
  @@index([tenantId])
  @@map("pipeline_stages")
}

model Vacancy {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String             @map("tenant_id") @db.Uuid
  title                 String
  department            String
  summary               String
  responsibilities      String             @default("")
  benefits              String             @default("")
  requirementsRequired  String             @default("") @map("requirements_required")
  requirementsDesirable String             @default("") @map("requirements_desirable")
  category              JobCategory        @default(general)
  level                 ExperienceLevel
  minYears              Int                @default(0) @map("min_years")
  minEducation          String?            @map("min_education")
  languages             String[]
  employmentType        EmploymentType     @map("employment_type")
  workMode              WorkMode           @map("work_mode")
  province              String
  municipality          String?
  salaryMin             Int?               @map("salary_min")
  salaryMax             Int?               @map("salary_max")
  showSalary            Boolean            @default(false) @map("show_salary")
  openings              Int                @default(1)
  status                VacancyStatus      @default(draft)
  publishedAt           DateTime?          @map("published_at")
  closesAt              DateTime?          @map("closes_at")
  pipelineId            String             @map("pipeline_id") @db.Uuid
  ownerId               String?            @map("owner_id") @db.Uuid
  knockoutRules         Json               @default("[]") @map("knockout_rules")
  scoringOverrides      Json?              @map("scoring_overrides")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  pipeline              Pipeline           @relation(fields: [pipelineId], references: [id])
  skills                VacancySkill[]
  evaluators            VacancyEvaluator[]

  @@index([tenantId, status])
  @@map("vacancies")
}

model VacancySkill {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  vacancyId String    @map("vacancy_id") @db.Uuid
  name      String
  kind      SkillKind
  vacancy   Vacancy   @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, name])
  @@index([tenantId])
  @@map("vacancy_skills")
}

// Personas asignadas a una vacante (responsable de area, evaluadores). Deja listo el comite futuro.
model VacancyEvaluator {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  vacancyId String  @map("vacancy_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  vacancy   Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, userId])
  @@index([tenantId])
  @@map("vacancy_evaluators")
}

enum ApiKeyKind {
  public
  secret
}

enum ApplicationStatus {
  received
  screening
  shortlisted
  in_review
  low_fit
  knocked_out
  interview
  assessment
  selection
  selected
  not_selected
  on_hold
  hired
  withdrawn
}

// Estado de procesamiento asincrono (docs/02 seccion 4). analysis_failed nunca descarta: va a revision manual.
enum ProcessingStatus {
  pending
  extracting
  ready
  unreadable
  failed
}

enum ScanStatus {
  pending
  clean
  infected
}

// Clave publica (pk_, identifica al tenant en el widget) o secreta (sk_, solo se guarda el hash).
model ApiKey {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  kind           ApiKeyKind
  label          String
  publicKey      String?    @unique @map("public_key")
  secretHash     String?    @unique @map("secret_hash")
  allowedOrigins String[]   @map("allowed_origins")
  revokedAt      DateTime?  @map("revoked_at")
  createdAt      DateTime   @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("api_keys")
}

model Candidate {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  email           String
  fullName        String          @map("full_name")
  phone           String
  location        String
  educationLevel  String          @map("education_level")
  yearsExperience Int             @map("years_experience")
  skills          String[]
  languages       String[]
  preferredMode   WorkMode?       @map("preferred_mode")
  availability    String?
  portfolioUrl    String?         @map("portfolio_url")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  applications    Application[]
  consents        ConsentRecord[]

  @@unique([tenantId, email])
  @@map("candidates")
}

// vacancyId nulo = bolsa general de talento.
model Application {
  id          String                    @id @default(uuid()) @db.Uuid
  tenantId    String                    @map("tenant_id") @db.Uuid
  candidateId String                    @map("candidate_id") @db.Uuid
  vacancyId   String?                   @map("vacancy_id") @db.Uuid
  trackingId  String                    @unique @map("tracking_id")
  status      ApplicationStatus         @default(received)
  processing  ProcessingStatus          @default(pending)
  source      String                    @default("widget")
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")
  candidate   Candidate                 @relation(fields: [candidateId], references: [id])
  documents   Document[]
  history     ApplicationStageHistory[]
  consents    ConsentRecord[]

  @@index([tenantId, vacancyId])
  @@index([tenantId, candidateId])
  @@map("applications")
}

model ApplicationStageHistory {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  applicationId String             @map("application_id") @db.Uuid
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  actorId       String?            @map("actor_id") @db.Uuid
  automatic     Boolean            @default(false)
  reason        String
  createdAt     DateTime           @default(now()) @map("created_at")
  application   Application        @relation(fields: [applicationId], references: [id])

  @@index([tenantId, applicationId])
  @@map("application_stage_history")
}

model Document {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  applicationId String           @map("application_id") @db.Uuid
  storageKey    String           @map("storage_key")
  originalName  String           @map("original_name")
  mimeType      String           @map("mime_type")
  sizeBytes     Int              @map("size_bytes")
  sha256        String
  scanStatus    ScanStatus       @default(pending) @map("scan_status")
  extractedText String?          @map("extracted_text")
  extractStatus ProcessingStatus @default(pending) @map("extract_status")
  createdAt     DateTime         @default(now()) @map("created_at")
  application   Application      @relation(fields: [applicationId], references: [id])

  @@index([tenantId, applicationId])
  @@map("documents")
}

model ConsentRecord {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  candidateId   String      @map("candidate_id") @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  noticeVersion String      @map("notice_version")
  ipTruncated   String?     @map("ip_truncated")
  acceptedAt    DateTime    @default(now()) @map("accepted_at")
  candidate     Candidate   @relation(fields: [candidateId], references: [id])
  application   Application @relation(fields: [applicationId], references: [id])

  @@index([tenantId, candidateId])
  @@map("consent_records")
}
