generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  recruiter
  area_manager
}

enum TenantStatus {
  active
  suspended
}

model Tenant {
  id                  String          @id @default(uuid()) @db.Uuid
  name                String
  slug                String          @unique
  status              TenantStatus    @default(active)
  screeningMode       ScreeningMode   @default(rules) @map("screening_mode")
  aiMonthlyQuota      Int             @default(0) @map("ai_monthly_quota")
  rejectionNotice     RejectionNotice @default(manual) @map("rejection_notice")
  rejectionDelayHours Int             @default(24) @map("rejection_delay_hours")
  autoConfirmHire     Boolean         @default(false) @map("auto_confirm_hire")
  createdAt           DateTime        @default(now()) @map("created_at")
  memberships         Membership[]
  invitations         Invitation[]
  auditLogs           AuditLog[]

  @@map("tenants")
}

// Usuario global (el correo es unico en la plataforma). Pertenece a tenants via Membership.
model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  name         String
  passwordHash String          @map("password_hash")
  isSuperAdmin Boolean         @default(false) @map("is_super_admin")
  createdAt    DateTime        @default(now()) @map("created_at")
  memberships  Membership[]
  sessions     Session[]
  resets       PasswordReset[]

  @@map("users")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@map("memberships")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id])

  @@map("password_resets")
}

model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  email      String
  role       Role
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@map("invitations")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  target    String?
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

enum VacancyStatus {
  draft
  published
  paused
  closed
}

enum JobCategory {
  general
  technical
  operational
  administrative
  managerial
  junior
}

enum ExperienceLevel {
  internship
  junior
  semi_senior
  senior
  managerial
}

enum EmploymentType {
  full_time
  part_time
  contract
  temporary
  internship
}

enum WorkMode {
  onsite
  hybrid
  remote
}

enum SkillKind {
  required
  desirable
}

enum StageType {
  screening
  interview
  assessment
  selection
  hiring
  custom
}

model Pipeline {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  name      String
  isDefault Boolean         @default(false) @map("is_default")
  createdAt DateTime        @default(now()) @map("created_at")
  stages    PipelineStage[]
  vacancies Vacancy[]

  @@index([tenantId])
  @@map("pipelines")
}

model PipelineStage {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  pipelineId String    @map("pipeline_id") @db.Uuid
  name       String
  type       StageType
  position   Int
  enabled    Boolean   @default(true)
  // Configuracion propia de la etapa y regla de transicion (manual | umbral | resultado de examen).
  config     Json      @default("{}")
  transition Json      @default("{\"mode\":\"manual\"}")
  pipeline   Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, position])
  @@index([tenantId])
  @@map("pipeline_stages")
}

model Vacancy {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String             @map("tenant_id") @db.Uuid
  title                 String
  department            String
  summary               String
  responsibilities      String             @default("")
  benefits              String             @default("")
  requirementsRequired  String             @default("") @map("requirements_required")
  requirementsDesirable String             @default("") @map("requirements_desirable")
  category              JobCategory        @default(general)
  level                 ExperienceLevel
  minYears              Int                @default(0) @map("min_years")
  minEducation          String?            @map("min_education")
  languages             String[]
  employmentType        EmploymentType     @map("employment_type")
  workMode              WorkMode           @map("work_mode")
  province              String
  municipality          String?
  salaryMin             Int?               @map("salary_min")
  salaryMax             Int?               @map("salary_max")
  showSalary            Boolean            @default(false) @map("show_salary")
  openings              Int                @default(1)
  status                VacancyStatus      @default(draft)
  publishedAt           DateTime?          @map("published_at")
  closesAt              DateTime?          @map("closes_at")
  pipelineId            String             @map("pipeline_id") @db.Uuid
  ownerId               String?            @map("owner_id") @db.Uuid
  knockoutRules         Json               @default("[]") @map("knockout_rules")
  scoringOverrides      Json?              @map("scoring_overrides")
  autoSelect            Boolean            @default(false) @map("auto_select")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  pipeline              Pipeline           @relation(fields: [pipelineId], references: [id])
  skills                VacancySkill[]
  evaluators            VacancyEvaluator[]

  @@index([tenantId, status])
  @@map("vacancies")
}

model VacancySkill {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  vacancyId String    @map("vacancy_id") @db.Uuid
  name      String
  kind      SkillKind
  vacancy   Vacancy   @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, name])
  @@index([tenantId])
  @@map("vacancy_skills")
}

// Personas asignadas a una vacante (responsable de area, evaluadores). Deja listo el comite futuro.
model VacancyEvaluator {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  vacancyId String  @map("vacancy_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  vacancy   Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, userId])
  @@index([tenantId])
  @@map("vacancy_evaluators")
}

enum ApiKeyKind {
  public
  secret
}

enum ApplicationStatus {
  received
  screening
  shortlisted
  in_review
  low_fit
  knocked_out
  interview
  assessment
  selection
  selected
  not_selected
  on_hold
  hired
  withdrawn
}

// Estado de procesamiento asincrono (docs/02 seccion 4). analysis_failed nunca descarta: va a revision manual.
enum ProcessingStatus {
  pending
  extracting
  ready
  unreadable
  failed
}

enum ScanStatus {
  pending
  clean
  infected
}

// Clave publica (pk_, identifica al tenant en el widget) o secreta (sk_, solo se guarda el hash).
model ApiKey {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  kind           ApiKeyKind
  label          String
  publicKey      String?    @unique @map("public_key")
  secretHash     String?    @unique @map("secret_hash")
  allowedOrigins String[]   @map("allowed_origins")
  revokedAt      DateTime?  @map("revoked_at")
  createdAt      DateTime   @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("api_keys")
}

model Candidate {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  email           String
  fullName        String          @map("full_name")
  phone           String
  location        String
  educationLevel  String          @map("education_level")
  yearsExperience Int             @map("years_experience")
  skills          String[]
  languages       String[]
  preferredMode   WorkMode?       @map("preferred_mode")
  availability    String?
  portfolioUrl    String?         @map("portfolio_url")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  applications    Application[]
  consents        ConsentRecord[]

  @@unique([tenantId, email])
  @@map("candidates")
}

// vacancyId nulo = bolsa general de talento.
model Application {
  id          String                    @id @default(uuid()) @db.Uuid
  tenantId    String                    @map("tenant_id") @db.Uuid
  candidateId String                    @map("candidate_id") @db.Uuid
  vacancyId   String?                   @map("vacancy_id") @db.Uuid
  trackingId  String                    @unique @map("tracking_id")
  status      ApplicationStatus         @default(received)
  processing  ProcessingStatus          @default(pending)
  source      String                    @default("widget")
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")
  candidate   Candidate                 @relation(fields: [candidateId], references: [id])
  documents   Document[]
  history     ApplicationStageHistory[]
  consents    ConsentRecord[]
  notes       ApplicationNote[]

  @@index([tenantId, vacancyId])
  @@index([tenantId, candidateId])
  @@map("applications")
}

model ApplicationStageHistory {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  applicationId String             @map("application_id") @db.Uuid
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  actorId       String?            @map("actor_id") @db.Uuid
  automatic     Boolean            @default(false)
  reason        String
  createdAt     DateTime           @default(now()) @map("created_at")
  application   Application        @relation(fields: [applicationId], references: [id])

  @@index([tenantId, applicationId])
  @@map("application_stage_history")
}

model Document {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  applicationId String           @map("application_id") @db.Uuid
  storageKey    String           @map("storage_key")
  originalName  String           @map("original_name")
  mimeType      String           @map("mime_type")
  sizeBytes     Int              @map("size_bytes")
  sha256        String
  scanStatus    ScanStatus       @default(pending) @map("scan_status")
  extractedText String?          @map("extracted_text")
  extractStatus ProcessingStatus @default(pending) @map("extract_status")
  createdAt     DateTime         @default(now()) @map("created_at")
  application   Application      @relation(fields: [applicationId], references: [id])

  @@index([tenantId, applicationId])
  @@map("documents")
}

model ConsentRecord {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  candidateId   String      @map("candidate_id") @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  noticeVersion String      @map("notice_version")
  ipTruncated   String?     @map("ip_truncated")
  acceptedAt    DateTime    @default(now()) @map("accepted_at")
  candidate     Candidate   @relation(fields: [candidateId], references: [id])
  application   Application @relation(fields: [applicationId], references: [id])

  @@index([tenantId, candidateId])
  @@map("consent_records")
}

enum ScreeningMode {
  rules
  ai
}

// Resultado de preseleccion (docs/03 seccion 2). Mismo objeto para los modos rules y ai.
// vacancyId es la vacante contra la que se puntuo: la de la postulacion, o una vacante afin si es sugerencia de la bolsa.
model ScreeningResult {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  applicationId   String        @map("application_id") @db.Uuid
  vacancyId       String        @map("vacancy_id") @db.Uuid
  mode            ScreeningMode
  overall         Int?
  recommendation  String
  dimensions      Json          @default("[]")
  matched         Json          @default("[]")
  missing         Json          @default("[]")
  reasons         Json          @default("[]")
  knockoutReasons Json          @default("[]") @map("knockout_reasons")
  riskFlags       Json          @default("[]") @map("risk_flags")
  confidence      String?
  notes           Json          @default("[]")
  provider        String?
  model           String?
  promptVersion   String?       @map("prompt_version")
  weightsVersion  String        @map("weights_version")
  inputHash       String?       @map("input_hash")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([tenantId, applicationId, createdAt])
  @@index([tenantId, vacancyId, overall])
  @@map("screening_results")
}

// Una fila por llamada a un proveedor de IA: tokens, costo estimado y latencia (docs/03 7.6). Sin texto del CV.
model AiUsage {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  applicationId String?  @map("application_id") @db.Uuid
  provider      String
  model         String
  inputTokens   Int      @map("input_tokens")
  outputTokens  Int      @map("output_tokens")
  costMicros    Int      @map("cost_micros")
  latencyMs     Int      @map("latency_ms")
  result        String
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@map("ai_usage")
}

model UsageCounter {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  month      String
  aiAnalyses Int    @default(0) @map("ai_analyses")

  @@unique([tenantId, month])
  @@map("usage_counters")
}

// Notas internas de RRHH y de responsables de area sobre una postulacion.
model ApplicationNote {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  authorId      String      @map("author_id") @db.Uuid
  body          String
  createdAt     DateTime    @default(now()) @map("created_at")
  application   Application @relation(fields: [applicationId], references: [id])

  @@index([tenantId, applicationId, createdAt])
  @@map("application_notes")
}

enum RejectionNotice {
  manual
  auto_delay
  none
}

enum InterviewMode {
  onsite
  virtual
}

enum InterviewStatus {
  scheduled
  cancelled
  completed
}

// Plantillas de correo por tipo de mensaje, con variables {{nombre}}, {{vacante}}, etc. y vista previa.
model EmailTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  name      String
  subject   String
  body      String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@map("email_templates")
}

// Registro de envios. No guarda el cuerpo (puede traer datos personales): solo quien, que plantilla y el resultado.
model EmailLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  applicationId String?  @map("application_id") @db.Uuid
  toEmail       String   @map("to_email")
  templateKey   String   @map("template_key")
  subject       String
  status        String
  error         String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, applicationId, createdAt])
  @@map("email_logs")
}

// Correos diferidos (aviso de rechazo con retraso). Se cancelan si el descarte se revierte.
model ScheduledEmail {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  templateKey   String    @map("template_key")
  sendAt        DateTime  @map("send_at")
  sentAt        DateTime? @map("sent_at")
  cancelledAt   DateTime? @map("cancelled_at")

  @@index([sendAt])
  @@index([tenantId, applicationId])
  @@map("scheduled_emails")
}

model Interview {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  applicationId      String          @map("application_id") @db.Uuid
  scheduledAt        DateTime        @map("scheduled_at")
  durationMin        Int             @default(45) @map("duration_min")
  mode               InterviewMode
  location           String?
  meetingUrl         String?         @map("meeting_url")
  platform           String?
  participantIds     String[]        @map("participant_ids")
  messageToCandidate String?         @map("message_to_candidate")
  status             InterviewStatus @default(scheduled)
  calendarEventId    String?         @map("calendar_event_id")
  createdBy          String          @map("created_by") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@index([tenantId, applicationId])
  @@index([tenantId, scheduledAt])
  @@map("interviews")
}

// Llamadas y mensajes manuales con el candidato.
model Communication {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  type          String
  summary       String
  authorId      String   @map("author_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, applicationId, createdAt])
  @@map("communications")
}

enum QuestionType {
  multiple_choice
  true_false
  short_answer
}

enum AttemptStatus {
  invited
  in_progress
  submitted
  expired
}

// Examen generalista (docs/01 4.6): plantilla -> modulos -> preguntas. RRHH redacta las preguntas.
model AssessmentTemplate {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  name         String
  description  String             @default("")
  timeLimitMin Int                @map("time_limit_min")
  passingScore Int                @default(60) @map("passing_score")
  createdBy    String             @map("created_by") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at")
  modules      AssessmentModule[]

  @@index([tenantId])
  @@map("assessment_templates")
}

model AssessmentModule {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  templateId String             @map("template_id") @db.Uuid
  title      String
  position   Int
  template   AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questions  Question[]

  @@index([tenantId, templateId])
  @@map("assessment_modules")
}

model Question {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  moduleId      String           @map("module_id") @db.Uuid
  position      Int
  type          QuestionType
  prompt        String
  options       Json             @default("[]")
  // multiple_choice: indice de la opcion correcta; true_false: boolean; short_answer: sin clave (revision manual).
  correctAnswer Json?            @map("correct_answer")
  points        Int              @default(1)
  module        AssessmentModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([tenantId, moduleId])
  @@map("questions")
}

// Intento de un candidato. El enlace es de un solo uso: solo se guarda el hash del token. El temporizador es del servidor.
model AssessmentAttempt {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  applicationId String        @map("application_id") @db.Uuid
  templateId    String        @map("template_id") @db.Uuid
  tokenHash     String        @unique @map("token_hash")
  status        AttemptStatus @default(invited)
  expiresAt     DateTime      @map("expires_at")
  startedAt     DateTime?     @map("started_at")
  deadlineAt    DateTime?     @map("deadline_at")
  submittedAt   DateTime?     @map("submitted_at")
  timedOut      Boolean       @default(false) @map("timed_out")
  // Copia de las preguntas al iniciar (con la clave): editar la plantilla despues no altera un intento en curso.
  snapshot      Json?
  answers       Json          @default("{}")
  autoPoints    Int?          @map("auto_points")
  manualPoints  Json          @default("{}") @map("manual_points")
  totalPoints   Int?          @map("total_points")
  needsReview   Boolean       @default(false) @map("needs_review")
  finalScore    Int?          @map("final_score")
  createdBy     String        @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([tenantId, applicationId])
  @@map("assessment_attempts")
}

// Evaluacion propia de la empresa (tecnica, de campo...): la plataforma solo registra el proceso y el resultado.
model ExternalAssessmentRecord {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  description   String
  performedAt   DateTime @map("performed_at")
  method        String
  evaluators    String[]
  result        String
  score         Int?
  observations  String   @default("")
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, applicationId])
  @@map("external_assessment_records")
}

enum SelectionStance {
  favor
  against
  neutral
}

enum DeliveryStatus {
  pending
  success
  failed
}

// Comentario de un evaluador asignado antes de decidir. Deja listo el modelo para comites futuros.
model SelectionComment {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  applicationId String          @map("application_id") @db.Uuid
  authorId      String          @map("author_id") @db.Uuid
  stance        SelectionStance
  body          String
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([tenantId, applicationId])
  @@map("selection_comments")
}

// Decision de seleccion: humana por defecto; si es automatica queda marcada (docs/01 4.7).
model SelectionDecision {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  decision      String
  decidedBy     String?  @map("decided_by") @db.Uuid
  automatic     Boolean  @default(false)
  reason        String
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, applicationId])
  @@map("selection_decisions")
}

model Hire {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  applicationId String    @unique @map("application_id") @db.Uuid
  candidateId   String    @map("candidate_id") @db.Uuid
  vacancyId     String?   @map("vacancy_id") @db.Uuid
  hiredBy       String?   @map("hired_by") @db.Uuid
  automatic     Boolean   @default(false)
  startDate     DateTime? @map("start_date")
  hiredAt       DateTime  @default(now()) @map("hired_at")
  // Copia exacta de lo entregado al exterior (nomina / RRHH).
  payload       Json

  @@index([tenantId, hiredAt])
  @@map("hires")
}

model WebhookEndpoint {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  url       String
  // Secreto de firma cifrado en reposo; se muestra una sola vez al crearlo o rotarlo.
  secretEnc String    @map("secret_enc")
  events    String[]
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  rotatedAt DateTime? @map("rotated_at")

  @@index([tenantId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  endpointId    String         @map("endpoint_id") @db.Uuid
  eventId       String         @map("event_id")
  event         String
  payload       Json
  status        DeliveryStatus @default(pending)
  attempts      Int            @default(0)
  nextAttemptAt DateTime?      @map("next_attempt_at")
  lastStatus    Int?           @map("last_status")
  lastError     String?        @map("last_error")
  deliveredAt   DateTime?      @map("delivered_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@index([tenantId, endpointId, createdAt])
  @@map("webhook_deliveries")
}
